{
    "compilerOptions": {
      "target": "ES2022",
      "module": "ES2020",
      "moduleResolution": "bundler",
      "outDir": "./dist/renderer",
      "rootDir": "./src/renderer",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "lib": ["ES2022", "DOM"]
    },
    "include": ["src/renderer/**/*"],
    "exclude": ["node_modules", "dist"]
  }